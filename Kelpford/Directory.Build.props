<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CI overrides this, e.g. dotnet publish /p:Version=1.4.2 -->
    <Version>1.0.0</Version>
    <Company>Kelpford</Company>
    <Product>Kelpford Hub</Product>
  </PropertyGroup>
</Project>
